{
  "name": "cmms",
  "version": "0.1.0",
  "private": true,
  "description": "Internal maintenance, asset, and work-order management application",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "e2e:server": "tsx e2e/reset-db.ts && DATABASE_URL=${E2E_DATABASE_URL:-postgres://cmms:cmms_dev_password@localhost:5432/cmms_e2e} next dev -p 3100"
  },
  "dependencies": {
    "csv-parse": "7.0.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "pg-boss": "12.26.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
