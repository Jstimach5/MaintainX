# Copy this file to .env and fill in real values. Never commit .env.
# Generate strong secrets with:  openssl rand -base64 32

# ── Core ────────────────────────────────────────────────────────────────
# Postgres connection string (running WITHOUT Docker; compose builds its
# own from POSTGRES_PASSWORD below).
DATABASE_URL=postgres://cmms:change_me@localhost:5432/cmms_dev

# Directory where uploaded pictures/files are stored (created
# automatically; must be on persistent storage in production).
STORAGE_DIR=./storage

# Port the web app listens on (dev / bare-metal; prod compose fixes 3000
# internally and only Caddy is public).
PORT=3000

# Absolute public URL of the app. Invitation and password-reset links are
# built from this — in production it MUST be the real HTTPS address,
# never localhost.
APP_URL=http://localhost:3000

# ── docker compose (production: docker-compose.prod.yml) ───────────────
# Database password used inside the compose network. Required.
# POSTGRES_PASSWORD=

# Public domain Caddy serves (HTTPS via Let's Encrypt). Required in prod.
# APP_DOMAIN=cmms.example.com

# Email address Let's Encrypt uses for certificate expiry notices.
# ACME_EMAIL=you@example.com

# ── Security ────────────────────────────────────────────────────────────
# Set to 1 when the app is served over HTTPS. Marks session cookies
# Secure. Production compose sets this automatically.
COOKIE_SECURE=

# ── Email (invitations, password resets, notifications) ────────────────
# Leave SMTP_HOST empty for no email: invitations then work by copy-link
# and in-app notifications remain the source of truth.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); leave false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Maintenance
SMTP_FROM_EMAIL=
# Force dev behavior (log, never send) even when SMTP_HOST is set.
# EMAIL_MODE=dev

# ── Safety rails ────────────────────────────────────────────────────────
# The seed script refuses to run when NODE_ENV=production; SEED_FORCE=1
# overrides for genuinely throwaway databases only.
# SEED_FORCE=
