# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL=postgres://cmms:change_me@localhost:5432/cmms_dev

# Directory where uploaded pictures/files are stored (created automatically)
STORAGE_DIR=./storage

# Port the web app listens on
PORT=3000

# Optional: SMTP url for the email notification adapter. Leave empty to keep
# notifications in-app only (the default).
SMTP_URL=
